# This repository is intentionally deny-by-default.  The workspace also holds
# licensed vendor documents, generated data, build caches and live credentials.
/*
!/.gitignore
!/.gitattributes
!/.gitmodules
!/README.md
!/README_Coastal_Warning_System.md
!/CoastWatch_项目最新总览_2026-08-14.md
!/docs/
!/firmware/
!/ml/
!/ops/
!/server/
!/tests/
!/tools/
!/website

# Project documentation only.
/docs/*
!/docs/*.md

# Firmware source only.
/firmware/*
!/firmware/esp32/
!/firmware/openmv/
/firmware/esp32/*
!/firmware/esp32/.gitignore
!/firmware/esp32/platformio.ini
!/firmware/esp32/README.md
!/firmware/esp32/include/
!/firmware/esp32/src/
!/firmware/esp32/test/
/firmware/openmv/*
!/firmware/openmv/*.py
!/firmware/openmv/README.md

# ML source/config/tests only; datasets, reports, runs and artifacts stay local.
/ml/*
!/ml/.gitignore
!/ml/.env.example
!/ml/*.md
!/ml/pyproject.toml
!/ml/requirements.txt
!/ml/requirements.lock
!/ml/coastal_risk/
!/ml/coastwatch_impact/
!/ml/configs/
!/ml/docs/
!/ml/tests/

# Backend source/tests/templates only.
/server/*
!/server/.gitignore
!/server/pytest.ini
!/server/README.md
!/server/requirements.txt
!/server/requirements-runtime.txt
!/server/app/
!/server/docs/
!/server/tests/
!/server/examples/
!/server/models/
/server/models/*
!/server/models/README.md
/server/examples/*
!/server/examples/official_dataset_bundle/
/server/examples/official_dataset_bundle/*
!/server/examples/official_dataset_bundle/harmonized.template.csv
!/server/examples/official_dataset_bundle/manifest.template.json
!/server/examples/official_dataset_bundle/raw/
/server/examples/official_dataset_bundle/raw/*
!/server/examples/official_dataset_bundle/raw/.gitignore
!/server/examples/official_dataset_bundle/raw/README.md

# Operations source only; the live Cloudflare configuration is never tracked.
/ops/*
!/ops/*.ps1
!/ops/*.py
!/ops/*.psm1
!/ops/README.md
!/ops/tests/

# Root tests and the secret-generation helper source only.
/tests/*
!/tests/*.py
/tools/*
!/tools/ensure_tunnel_secret.py

# Credentials and local operational state (defence in depth).
/server/.device_token
/firmware/esp32/include/secrets.h
/firmware/esp32/include/tunnel_secret.h
/ops/cloudflared-config.yml
**/.env
**/.env.*
!**/.env.example
**/*credential*.json
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/id_rsa*
**/id_ed25519*

# Runtime databases, source datasets and model artifacts.
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.parquet
**/*.feather
**/*.npy
**/*.npz
**/*.pkl
**/*.pickle
**/*.joblib
**/*.onnx
**/*.pt
**/*.pth
**/*.h5
**/*.tflite
**/*.csv.gz

# Build/cache/local IDE outputs.
**/.venv/
**/venv/
**/node_modules/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage*
**/htmlcov/
**/.pio/
**/build/
**/build-host/
**/dist/
**/out/
**/.vscode/
**/*.o
**/*.obj
**/*.a
**/*.lib
**/*.bin
**/*.elf
**/*.hex
**/*.map
**/*.exe
**/*.dll

# Archives, logs and temporary files.
**/*.zip
**/*.7z
**/*.rar
**/*.tar
**/*.gz
**/*.log
**/*.tmp
**/*.bak
**/*.swp
**/.DS_Store
**/Thumbs.db
